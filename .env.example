# @BotFather dan olingan token
BOT_TOKEN=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Cheksiz foydalanuvchilar ID lari (vergul bilan)
UNLIMITED_IDS=

# O'zingizning Telegram ID (bir nechta bo'lsa vergul bilan)
ADMIN_IDS=
# Pul tushadigan karta
CARD_NUMBER=
CARD_OWNER=

# Paketlar: hujjat_soni:narx_so'm
PACKAGES=1:5000,3:12000,10:35000
FREE_CREDITS=1
REFERRAL_BONUS=1
# 1 = AI chekni tasdiqlasa avtomatik kredit beriladi, 0 = har doim admin tasdiqlaydi
AUTO_APPROVE=1
MAX_PARALLEL_JOBS=4

# Serverda (Render) majburiy: Neon PostgreSQL ulanish manzili. Bo'sh bo'lsa lokal SQLite ishlatiladi
DATABASE_URL=
